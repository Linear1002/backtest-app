# このファイルを .env にコピーして値を入れる(.env はコミットしない)。
# 値を空のままにした行は、書いていないのと同じ(既定値を使う)。

# J-Quants API のキー(ダッシュボードの [API Keys] 画面で発行する)。東証の銘柄を使うときだけ必要
JQUANTS_API_KEY=

# --- 以下は任意(ふつうは空のままでよい) ---

# J-Quants への1分あたりのリクエスト数の上限(既定 5 = Free プラン。Light プランなら 60)
JQUANTS_REQUESTS_PER_MINUTE=
# 保存したデータを何日たったら取り直すか(既定 7)
JQUANTS_MAX_AGE_DAYS=
# 株価データの保存先(既定はリポジトリ直下の data/)
BACKTEST_DATA_DIR=
# API を直接呼んでよい画面のオリジン(カンマ区切り。既定 http://localhost:3000,http://127.0.0.1:3000)
BACKTEST_CORS_ORIGINS=
# 総当たり(docs/sweep.md)の計算に使うプロセスの数(既定は CPU のコアの数)
BACKTEST_SWEEP_WORKERS=
